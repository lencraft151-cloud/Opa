# --- Server ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# Verzeichnis für Datenbank, Messwerte und Verschlüsselungsschlüssel.
#
# LEER LASSEN ist die Empfehlung. Dann liegt alles außerhalb dieses Ordners –
# unter Linux in ~/.local/share/smarthome-hub, unter macOS in
# ~/Library/Application Support/smarthome-hub, unter Windows in %APPDATA%.
#
# Der Grund: Was hier im Projektordner liegt, ist beim nächsten
# Neu-Herunterladen weg. Was daneben liegt, überlebt jede Aktualisierung.
# Ein bereits vorhandener ./data-Ordner zieht beim ersten Start selbst um.
#
# Setzen nur, wenn der Ort feststehen soll – etwa ein Docker-Volume:
# DATA_DIR=/var/lib/smarthome-hub
DATA_DIR=

# --- Sicherheit -----------------------------------------------------------
# Schlüssel zum Verschlüsseln der Zugangsdaten (Hue Application Key,
# Shelly- und Box-Passwörter, Spotify-Token) auf der Festplatte.
#
# LEER LASSEN ist auch hier die Empfehlung: Der Hub legt beim ersten Start
# selbst einen an und bewahrt ihn als `secret.key` im Datenordner auf – also
# dort, wo auch die Daten liegen, die er schützt. Beides zusammen überlebt
# jede Aktualisierung.
#
# Setzen nur, wenn der Schlüssel von außen kommen soll (Docker-Secret,
# systemd-Credential). Erzeugen mit:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SECRET_KEY=

# Auf true setzen, um die Bearer-Token-Prüfung zu deaktivieren
# (nur für lokale Entwicklung sinnvoll).
AUTH_DISABLED=false

# --- Polling / Telemetrie -------------------------------------------------
# Abfrageintervall der Integrationen in Sekunden
POLL_INTERVAL_SECONDS=15
# Aufbewahrungsdauer der Messwerte in Tagen
TELEMETRY_RETENTION_DAYS=90
# Minimaler Abstand zwischen zwei gespeicherten Messwerten je Sensor (Sekunden)
TELEMETRY_MIN_INTERVAL_SECONDS=60

# --- Discovery ------------------------------------------------------------
# Hue-Cloud-Discovery (https://discovery.meethue.com) erlauben.
# Bei false wird ausschließlich lokal per mDNS/Subnetz-Scan gesucht.
ALLOW_CLOUD_DISCOVERY=true
# Timeout für Geräte-Discovery in Millisekunden
DISCOVERY_TIMEOUT_MS=5000

# --- Aktualisierung des Hubs selbst --------------------------------------
# Adresse, unter der nach einer neueren Fassung gefragt wird (etwa die
# Releases-API des Projekts). Leer heißt: gar nicht fragen. Ein Haushalts-Hub
# telefoniert nicht ungefragt nach Hause.
HUB_UPDATE_CHECK_URL=
# Woher der Quelltext kommt, wenn keine Git-Arbeitskopie vorliegt (entpacktes
# Archiv, Abbild ohne .git). Der Hub holt sie sich dann beim Aktualisieren
# selbst; Datenbank, Messwerte und .env bleiben dabei unangetastet.
HUB_REPO_URL=https://github.com/lencraft151-cloud/Opa
HUB_BRANCH=main

# --- Logging --------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info
