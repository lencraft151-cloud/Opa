# --- Server ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# Verzeichnis für Datenbank (JSON) und Telemetrie-Dateien
DATA_DIR=./data

# --- Sicherheit -----------------------------------------------------------
# Master-Key zum Verschlüsseln der Integrations-Secrets (Hue Application Key,
# Shelly Passwörter) auf der Festplatte. Muss gesetzt und geheim gehalten
# werden. Erzeugen mit:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SECRET_KEY=

# Auf true setzen, um die Bearer-Token-Prüfung zu deaktivieren
# (nur für lokale Entwicklung sinnvoll).
AUTH_DISABLED=false

# --- Polling / Telemetrie -------------------------------------------------
# Abfrageintervall der Integrationen in Sekunden
POLL_INTERVAL_SECONDS=15
# Aufbewahrungsdauer der Messwerte in Tagen
TELEMETRY_RETENTION_DAYS=90
# Minimaler Abstand zwischen zwei gespeicherten Messwerten je Sensor (Sekunden)
TELEMETRY_MIN_INTERVAL_SECONDS=60

# --- Discovery ------------------------------------------------------------
# Hue-Cloud-Discovery (https://discovery.meethue.com) erlauben.
# Bei false wird ausschließlich lokal per mDNS/Subnetz-Scan gesucht.
ALLOW_CLOUD_DISCOVERY=true
# Timeout für Geräte-Discovery in Millisekunden
DISCOVERY_TIMEOUT_MS=5000

# --- Logging --------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info
