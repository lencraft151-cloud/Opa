{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Tests importieren die Quellen direkt mit .ts-Endung, weil sie über
    // tsx laufen und nicht kompiliert werden.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
