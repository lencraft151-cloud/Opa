{
  "name": "smarthome-hub",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "Vendor-neutraler Smart-Home-Hub: Philips Hue und Shelly in einer App, inkl. Haushalts-Einrichtung, Temperaturmessung und Automationen.",
  "engines": {
    "node": ">=20.11"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
